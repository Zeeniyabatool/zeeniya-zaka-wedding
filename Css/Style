/* ==========================
   GOLD PARTICLES
========================== */
#particles {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
    z-index: 5;
}

.particle {
    position: absolute;
    width: 5px;
    height: 5px;
    background: #D4AF37;
    border-radius: 50%;
    opacity: 0.9;

    box-shadow:
        0 0 6px #D4AF37,
        0 0 12px rgba(212, 175, 55, 0.8);

    animation: floatParticle 12s linear infinite;
}

@keyframes floatParticle {

    0% {
        transform: translateY(110vh);
        opacity: 0;
    }

    15% {
        opacity: 0.9;
    }

    50% {
        opacity: 0.7;
    }

    85% {
        opacity: 0.9;
    }

    100% {
        transform: translateY(-10vh);
        opacity: 0;
    }
}

