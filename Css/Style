/* ===========================
MUGHAL ARCH
=========================== */

.hero-card{

    position:relative;
    overflow:hidden;

}

.hero-card::before{

    content:"";

    position:absolute;

    inset:0;

    background:url("../assets/svg/mughal-arch.svg")
    center center no-repeat;

    background-size:70%;

    opacity:.08;

    pointer-events:none;

}
.hero-card::after{

content:"";

position:absolute;

width:160px;
height:160px;

top:20px;
right:20px;

background:
radial-gradient(circle,
rgba(212,175,55,.35),
transparent 70%);

opacity:.35;

filter:blur(25px);

}
.particles{

position:fixed;
inset:0;
pointer-events:none;

}

.particles span{

position:absolute;

width:4px;
height:4px;

background:#F4D97A;

border-radius:50%;

animation:float 10s linear infinite;

}

.particles span:nth-child(1){
left:10%;
top:100%;
animation-delay:0s;
}

.particles span:nth-child(2){
left:30%;
top:100%;
animation-delay:2s;
}

.particles span:nth-child(3){
left:50%;
top:100%;
animation-delay:4s;
}

.particles span:nth-child(4){
left:70%;
top:100%;
animation-delay:6s;
}

.particles span:nth-child(5){
left:90%;
top:100%;
animation-delay:8s;
}

.particles span:nth-child(6){
left:60%;
top:100%;
animation-delay:10s;
}

@keyframes floatParticle{

0%{

transform:translateY(0);
opacity:0;

}

20%{

opacity:1;

}

100%{

transform:translateY(-120vh);
opacity:0;

}

}
