/* ===========================================
   LUXURY ENVELOPE
=========================================== */

#loading-screen{
    position:fixed;
    inset:0;
    width:100%;
    height:100vh;
    display:flex;
    justify-content:center;
    align-items:center;
    background:linear-gradient(135deg,#0a3d2e,#0e5a46,#145c4c);
    overflow:hidden;
    z-index:99999;
}

.envelope{
    position:relative;
    width:320px;
    height:220px;
}

.envelope-back{
    position:absolute;
    width:100%;
    height:100%;
    background:#0b4d43;
    border-radius:8px;
    box-shadow:0 25px 60px rgba(0,0,0,.45);
}

.flap{
    position:absolute;
    top:0;
    width:100%;
    height:120px;
    background:#146554;
    clip-path:polygon(0 0,100% 0,50% 100%);
    transform-origin:top;
    transition:1s;
    z-index:4;
}

.letter{
    position:absolute;
    left:20px;
    top:20px;
    width:280px;
    height:180px;
    background:#fffdf7;
    border-radius:8px;
    text-align:center;
    padding-top:25px;
    transition:1s;
    z-index:2;
}

.letter img{
    width:70px;
    margin-bottom:12px;
}

.letter h2{
    color:#0b4d43;
    font-family:'Cinzel',serif;
    font-size:20px;
    margin:5px 0;
}

.letter p{
    color:#c9a227;
    font-size:18px;
    letter-spacing:3px;
}

.seal{
    position:absolute;
    left:50%;
    top:92px;
    transform:translateX(-50%);
    width:72px;
    height:72px;
    border:none;
    border-radius:50%;
    background:linear-gradient(#f7d774,#c9a227);
    color:#0b4d43;
    font-weight:bold;
    cursor:pointer;
    z-index:5;
    box-shadow:0 0 20px rgba(212,175,55,.6);
    transition:.3s;
}

.seal:hover{
    transform:translateX(-50%) scale(1.08);
}
#loading-screen{
    transition:opacity .8s ease, visibility .8s ease;
}

/* ===== Luxury Card Finish ===== */

.event-card,
.haldi-card,
.nikah-card,
.gallery-card {

    background: rgba(255,255,255,0.08);

    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);

    border: 1px solid rgba(212,175,55,.35);

    border-radius: 24px;

    box-shadow:
        0 12px 35px rgba(0,0,0,.18);

    transition:
        transform .4s ease,
        box-shadow .4s ease;
}

.event-card:hover,
.haldi-card:hover,
.nikah-card:hover,
.gallery-card:hover{

    transform: translateY(-8px);

    box-shadow:
        0 18px 45px rgba(212,175,55,.25);

}
#scroll-progress{
    position:fixed;
    top:0;
    left:0;
    width:0%;
    height:4px;
    background:linear-gradient(90deg,#D4AF37,#F7E7A1,#D4AF37);
    z-index:9999;
    transition:width .1s linear;
}
